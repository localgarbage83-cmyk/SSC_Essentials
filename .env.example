# --- Production (Vercel) -------------------------------------------------
# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Supabase > Project Settings > API. SERVER ONLY: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for 5-page previews (created automatically on first upload)
SUPABASE_PREVIEW_BUCKET=previews
# Public site URL (sitemap/metadata)
SITE_URL=https://your-project.vercel.app

# --- Optional ------------------------------------------------------------
# Set to "off" to skip live Google Drive reachability checks (offline testing only)
# DRIVE_CHECK=off
# Set to "off" if your Postgres does not use TLS (local Postgres only)
# DATABASE_SSL=off

# Local development needs NO variables: without DATABASE_URL the app uses an embedded
# Postgres (PGlite) in .data/ and stores previews in .data/previews. Disabled in production.
